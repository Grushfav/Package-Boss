# Backend — copy to .env in the project root

# development | production (production requires secure secrets below)
FLASK_ENV=development

# Required in production — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Database — Neon PostgreSQL in production; SQLite OK for local dev only
DATABASE_URL=
# DATABASE_URL=sqlite:///package_boss.db

BOSS_ID_SEQ_START=90001

FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173

WAREHOUSE_LINE1=2201 SW 59th Terrace
WAREHOUSE_CITY=West Park
WAREHOUSE_STATE=FL
WAREHOUSE_ZIP=33023
WAREHOUSE_COUNTRY=US

EMAIL_PROVIDER=console

# WhatsApp — console logs locally; meta sends via Meta Cloud API
WHATSAPP_PROVIDER=console
# WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0

ADMIN_EMAIL=admin@example.com
CLERK_EMAIL=clerk@example.com

# Optional — image uploads (Backblaze B2 via Cloudflare Worker)
# IMAGE_UPLOAD_WORKER_URL=https://your-worker.workers.dev
# IMAGE_UPLOAD_API_KEY=
# Optional alias — full presign endpoint (base URL is derived automatically):
# IMAGE_UPLOAD_URL=https://your-worker.workers.dev/upload-url
# STORAGE_PUBLIC_URL=

# Frontend (frontend/.env.local)
# VITE_API_URL=/api
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google OAuth (backend verifies ID tokens from the frontend)
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
